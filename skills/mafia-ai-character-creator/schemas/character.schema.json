{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mafia AI Character Creator Manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "displayName", "description", "status", "renderMode", "entry", "views", "requiredViews", "actions", "expressions", "api"],
  "properties": {
    "schemaVersion": {"const": 2},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "displayName": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "ready"]},
    "renderMode": {"enum": ["generated-art", "raster-puppet", "procedural-svg", "procedural-canvas", "rigged-svg", "raster-sprites"]},
    "target": {"type": "string"},
    "entry": {"type": "string", "minLength": 1},
    "moduleSystem": {"enum": ["esm", "commonjs", "global", "other"]},
    "views": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "requiredViews": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "actions": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "expressions": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "props": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "api": {
      "type": "object",
      "required": ["render", "capabilities"],
      "properties": {
        "render": {"type": "string", "minLength": 1},
        "capabilities": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
