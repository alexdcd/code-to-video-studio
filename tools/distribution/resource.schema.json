{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:code-to-video-studio:resource-distribution:v1",
  "title": "Code to Video Studio reusable resource metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "type",
    "distribution"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "distribution": {
      "enum": [
        "public",
        "pro",
        "private",
        "local"
      ]
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  }
}
